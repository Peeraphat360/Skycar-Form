# ── Server ──
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed SPA origins (CORS, credentials enabled)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Where /auth/line/callback redirects the browser back to after login
CLIENT_URL=http://localhost:5173

# ── Supabase (service role — bypasses RLS, keep secret) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session ──
# Use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# ── LINE Login ──
# https://developers.line.biz/console/ → your LINE Login channel
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3001/api/auth/line/callback
